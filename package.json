{
  "name": "hope-securetrack",
  "version": "1.0.0",
  "private": true,
  "description": "SecureTrack ERP — Multi-tenant enterprise resource planning platform",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node --max-old-space-size=6144 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint src tests scripts *.config.*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/security",
    "test:a11y": "vitest run tests/a11y",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:auth": "playwright test e2e/authenticated.spec.ts",
    "test:load": "node scripts/load-smoke.mjs",
    "test:load:certify": "node scripts/load-certify.mjs",
    "audit:deps": "node scripts/dependency-audit-report.mjs",
    "drill:dr": "node scripts/dr-drill.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "sbom": "node scripts/sbom.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:browser-writes": "node scripts/check-browser-writes.mjs",
    "check:service-role": "node scripts/check-service-role.mjs",
    "check:rls-inventory": "node scripts/rls-inventory.mjs",
    "check:security-static": "node scripts/check-browser-writes.mjs --strict ; node scripts/check-service-role.mjs --strict ; node scripts/rls-inventory.mjs",
    "ci": "npm run typecheck && npm run check:secrets && npm run check:browser-writes -- --strict && npm run check:service-role -- --strict && npm run check:rls-inventory && npm test && node scripts/production-readiness-audit.mjs && npm run openapi:generate && npm run sbom && npm run audit:deps",
    "audit:readiness": "node scripts/production-readiness-audit.mjs",
    "db:generate-types": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db seed",
    "db:gen-role-catalog": "node scripts/gen-role-catalog-migration.mjs",
    "test:e2e:payroll": "playwright test e2e/payroll-dual-control.spec.ts",
    "audit:bundle": "node scripts/bundle-audit.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.14.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.15.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.469.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "resend": "^6.18.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "supabase": "^2.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
