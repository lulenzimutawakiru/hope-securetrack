# SecureTrack ERP Print Agent
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AGENT_KEY=generate-a-long-random-secret
# Optional: poll interval ms
POLL_MS=5000
# Optional: log level debug|info|warn|error
LOG_LEVEL=info
# When true, writes label payloads to ./outbox for manual/Niimbot app import
OUTBOX_MODE=true
