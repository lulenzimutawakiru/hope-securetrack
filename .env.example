# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hope SecureTrack
NEXT_PUBLIC_COMPANY_NAME=Hope Design Group Ltd

# Security - Generate with: openssl rand -hex 32
QR_ENCRYPTION_KEY=your-32-byte-hex-key
QR_SIGNING_PRIVATE_KEY=your-ed25519-private-key-base64
QR_SIGNING_PUBLIC_KEY=your-ed25519-public-key-base64

# Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Rate Limiting
RATE_LIMIT_VERIFICATION=60
RATE_LIMIT_API=1000

# CAPTCHA (hCaptcha or Turnstile)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Print Agent
PRINT_AGENT_WS_URL=wss://your-project.supabase.co/functions/v1/print-agent-ws
