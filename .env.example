# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SecureTrack ERP
NEXT_PUBLIC_COMPANY_NAME=SecureTrack ERP

# Security - Generate with: openssl rand -hex 32
QR_ENCRYPTION_KEY=your-32-byte-hex-key
QR_SIGNING_PRIVATE_KEY=your-ed25519-private-key-base64
QR_SIGNING_PUBLIC_KEY=your-ed25519-public-key-base64

# Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Rate Limiting
RATE_LIMIT_VERIFICATION=60
RATE_LIMIT_API=1000
# Distributed rate limiting (Upstash Redis REST) - recommended for production so
# limits hold across multiple Vercel serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_AUTH_API=600
RATE_LIMIT_DEVICE_API=300
RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_REQUIRE_REDIS=false

# CAPTCHA (hCaptcha or Turnstile)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Print Agent
PRINT_AGENT_WS_URL=wss://your-project.supabase.co/functions/v1/print-agent-ws

# Resend (transactional email & notifications)
# https://resend.com/api-keys â€” never commit real keys
RESEND_API_KEY=re_xxxxxxxx
# Verified domain sender, e.g. SecureTrack ERP <noreply@mail.hopedesign.co.ug>
# Sandbox without domain: use onboarding@resend.dev (Resend docs)
RESEND_FROM_EMAIL=SecureTrack ERP <onboarding@resend.dev>
RESEND_FROM_NAME=SecureTrack ERP
RESEND_REPLY_TO=

# =============================================================================
# External providers (SecureTrack integrations hub)
# Sandbox is used automatically when keys are missing or *_SANDBOX=true
# =============================================================================
PAYMENT_SANDBOX=true
PROVIDERS_SANDBOX=true
BILLING_WEBHOOK_SECRET=

# MTN MoMo Collections
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_HOST=
MTN_MOMO_CALLBACK_SECRET=
MTN_MOMO_SANDBOX=true

# Airtel Money
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX
AIRTEL_MONEY_SANDBOX=true

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_SANDBOX=true

# Pesapal v3
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_SANDBOX=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Africa's Talking SMS
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_FROM=
AFRICASTALKING_SANDBOX=true

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SANDBOX=true

# Push — FCM and/or OneSignal
FCM_SERVER_KEY=
FCM_PROJECT_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Mapbox (fleet / dispatch)
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Upstash QStash (durable serverless jobs)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=https://qstash.upstash.io

# CAPTCHA — Cloudflare Turnstile (also NEXT_PUBLIC_CAPTCHA_SITE_KEY / CAPTCHA_SECRET_KEY)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Document OCR
DOCUMENT_AI_ENDPOINT=
DOCUMENT_AI_API_KEY=
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_SANDBOX=true

# DocuSign (scaffold)
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=

# SSO / OIDC (Entra, Google) + SCIM
SSO_STATE_SECRET=
SSO_ENTRA_CLIENT_ID=
SSO_ENTRA_CLIENT_SECRET=
SSO_ENTRA_ISSUER=
NEXT_PUBLIC_SSO_AZURE=false
NEXT_PUBLIC_SSO_GOOGLE=false
SCIM_BEARER_TOKEN=
SCIM_DEFAULT_COMPANY_ID=
LOGIN_CAPTCHA_ALWAYS=false
QSTASH_AUTO_PING=false
